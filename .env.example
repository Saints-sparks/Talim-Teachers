# Copy to .env.local. All values are required — the build fails without them.
NEXT_PUBLIC_API_BASE_URL=https://talim-be-dev.onrender.com

# Cloudinary unsigned upload target for avatars and teaching resources.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Dev only: answer /teachers/today and /timetable/me from src/lib/fixtures/today.fixture.ts
# (ignored in production builds). Useful until the backend ships those endpoints.
# NEXT_PUBLIC_USE_FIXTURES=true

# Largest file (in MB) the Subjects page's upload sheet accepts; 50 when unset or not a positive number.
# NEXT_PUBLIC_MAX_UPLOAD_MB=50
